# Copy to .env.local and fill in. Never commit .env.local (see .gitignore).

# Supabase project URL and secret key (server-only -- never NEXT_PUBLIC_).
# Get these from the Supabase dashboard: Project Settings -> API.
# The secret key format is `sb_secret_...`; the older `service_role` JWT
# also still works but is being phased out during 2026.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Random salt used to hash IPs/emails before they touch the rate-limit
# table -- generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this resets everyone's rate-limit buckets. Keep it secret; it is
# not a HMAC key for anything security-critical, just enough to keep raw
# IPs out of the database.
CONTACT_IP_HASH_SALT=
