# Local dev: copy to supabase/functions/.env (auto-loaded by
# `supabase functions serve`). Never commit the real .env file.
#
# Production: `supabase secrets set --env-file supabase/functions/.env`
# (after filling in real values in your own local copy, not this one).

# --- WhatsApp Cloud API (whatsapp-notify) -----------------------------------
# Meta Business Manager -> WhatsApp -> API Setup. The access token is a
# long-lived System User token, not the 24h temporary token the quickstart
# page shows -- see the README's WhatsApp setup section.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Defaults to v23.0 if unset; bump when Meta deprecates the pinned version.
WHATSAPP_API_VERSION=
# Must be an APPROVED template with exactly 4 body placeholders, in this
# order: name, email, phone, message. See the README.
WHATSAPP_TEMPLATE_NAME=
# Defaults to en_US if unset -- must match the template's approved language.
WHATSAPP_TEMPLATE_LANGUAGE=
# Optional. Only takes effect when a manual invocation's request body sets
# "dry_run": true (the trigger/sweep's own calls never do) -- so simply
# having this set does NOT redirect real notifications. Use to exercise the
# pipeline without messaging real staff numbers.
WHATSAPP_RECIPIENT_OVERRIDE=

# --- SendGrid (daily-leads-report) ------------------------------------------
SENDGRID_API_KEY=
# Must be a verified sender (Single Sender or a verified domain) in SendGrid.
REPORT_FROM_EMAIL=
# Optional. Only takes effect when a manual invocation's request body sets
# "dry_run": true -- overrides the report_recipients table so the pipeline
# can be exercised without emailing real recipients.
REPORT_RECIPIENT_OVERRIDE=
